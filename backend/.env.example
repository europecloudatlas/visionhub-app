# Application
APP_NAME=VisionHub
DEBUG=True

# Security
SECRET_KEY=change-this-secret-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Database
DATABASE_URL=postgresql://visionhub:visionhub123@postgres:5432/visionhub

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# S3/MinIO Storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=visionhub
